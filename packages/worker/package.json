{
  "name": "@cloud-reader/worker",
  "version": "0.0.1",
  "private": true,
  "description": "Cloudflare Worker — REST API, D1, cron",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply cloud-reader --local",
    "db:migrate:remote": "wrangler d1 migrations apply cloud-reader --remote",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@cloud-reader/types": "workspace:*",
    "drizzle-orm": "^0.41.0",
    "fast-xml-parser": "^4.5.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250327.0",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.3",
    "vitest": "^3.1.1",
    "wrangler": "^4.4.0"
  }
}
