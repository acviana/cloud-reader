{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-reader",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-03-27",
  "compatibility_flags": ["nodejs_compat"],

  // D1 database binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud-reader",
      "database_id": "996fad41-7d45-4254-8c22-aafd3950b673",
      "migrations_dir": "drizzle"
    }
  ],

  // Hourly cron trigger for feed refresh
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
