{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-reader",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-03-27",
  "compatibility_flags": ["nodejs_compat"],

  // D1 database binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud-reader",
      "database_id": "996fad41-7d45-4254-8c22-aafd3950b673",
      "migrations_dir": "drizzle"
    }
  ],

  // Static assets — Vite build output from packages/app
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Hourly cron trigger for feed refresh
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
